# Copie para .env e substitua os valores de exemplo localmente.
# Nunca versione credenciais reais.
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://fisiomove:replace-me@localhost:5432/fisiomove
DB_ECHO=false
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_ISSUER=fisiomove-api
AUTH_AUDIENCE=fisiomove-mobile
# Pool limits are per worker; size PostgreSQL max_connections accordingly.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
# Docker only: match these credentials in DOCKER_DATABASE_URL (percent-encoded).
POSTGRES_DB=fisiomove
POSTGRES_USER=fisiomove
POSTGRES_PASSWORD=replace-me
DOCKER_DATABASE_URL=postgresql+psycopg://fisiomove:replace-me@db:5432/fisiomove
# Trust only the actual TLS reverse proxy; never use '*' in production.
FORWARDED_ALLOW_IPS=127.0.0.1
