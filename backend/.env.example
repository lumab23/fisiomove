# Copie para .env e substitua os valores de exemplo localmente.
# Nunca versione credenciais reais.
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://fisiomove:replace-me@localhost:5432/fisiomove
DB_ECHO=false
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_ISSUER=fisiomove-api
AUTH_AUDIENCE=fisiomove-mobile
