# Public build configuration only; never place API secrets in the mobile bundle.
# Supply the real HTTPS origin before a release build (no /api/v1 suffix).
FISIOMOVE_API_ORIGIN=https://api.example.test

# Optional debug-only LAN origin. Use your Mac IP, without /api/v1.
# FISIOMOVE_DEV_API_ORIGIN=http://192.168.1.20:8000
